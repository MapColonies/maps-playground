AWS_ACCESS_KEY_ID=accessKey
AWS_SECRET_ACCESS_KEY=secretKey
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:9000
AWS_BUCKET=maps-playground
INDEX_KEY=index.json
ITEMS_TIMEOUT=600
ITEMS_STALE=600
PUBLIC_CATALOG_HREF=/
PUBLIC_DEVPORTAL_HREF=/
PUBLIC_PUZZLE_HREF=/
PUBLIC_CACHE_DEBOUNCE_MS=500
# Agent chat is dark unless AGENT_ENABLED=true.
AGENT_ENABLED=false
LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_KEY=sk-litellm
AGENT_MODEL=gpt-4o
# Authoritative MapColonies developer-portal URL the agent cites as the source of
# truth for our service APIs. Leave blank to omit it from the prompt.
DEVELOPER_PORTAL_URL=
# Optional: expected browser Origin for /api/agent (defaults to the app's own origin).
# Set when the public URL differs from the internal one (e.g. behind a proxy).
AGENT_ALLOWED_ORIGIN=